-- DropForeignKey
ALTER TABLE "OrderItem" DROP CONSTRAINT IF EXISTS "OrderItem_productId_fkey";

-- AlterTable: add new OrderItem snapshot columns (nullable first, backfilled below)
ALTER TABLE "OrderItem"
  ADD COLUMN "printifyProductId" TEXT,
  ADD COLUMN "printifyVariantId" INTEGER,
  ADD COLUMN "name" TEXT,
  ADD COLUMN "image" TEXT;

-- Backfill any existing rows from the Product table before the link is dropped
UPDATE "OrderItem" oi
SET "printifyProductId" = p."id",
    "name" = p."name",
    "image" = p."images"[1]
FROM "Product" p
WHERE oi."productId" = p."id";

-- Anything left unmatched (shouldn't normally happen) gets a safe placeholder
-- so the NOT NULL constraints below don't fail.
UPDATE "OrderItem" SET "printifyProductId" = 'unknown' WHERE "printifyProductId" IS NULL;
UPDATE "OrderItem" SET "name" = 'Unknown item' WHERE "name" IS NULL;

-- Now that every row has a value, enforce NOT NULL
ALTER TABLE "OrderItem"
  ALTER COLUMN "printifyProductId" SET NOT NULL,
  ALTER COLUMN "name" SET NOT NULL;

-- Drop the old hard link to Product
ALTER TABLE "OrderItem" DROP COLUMN "productId";

-- AlterTable: Order gets fulfillment + tracking fields
ALTER TABLE "Order"
  ADD COLUMN "fulfillmentStatus" TEXT NOT NULL DEFAULT 'unfulfilled',
  ADD COLUMN "stripeSessionId" TEXT,
  ADD COLUMN "printifyOrderId" TEXT,
  ADD COLUMN "trackingNumber" TEXT,
  ADD COLUMN "trackingUrl" TEXT;

-- CreateIndex
CREATE UNIQUE INDEX "Order_stripeSessionId_key" ON "Order"("stripeSessionId");
